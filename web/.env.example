# Settings for the website when it runs on Node (for example on Vercel). Never commit real values.

# Where the backend lives. Read at BUILD time: set it before you deploy.
API_URL=https://your-api.onrender.com

# Must equal API_SHARED_SECRET on the backend. Generate one with:  openssl rand -hex 32
API_SHARED_SECRET=

# The site's login. On Vercel a missing login makes the site refuse to start (it never opens up).
BASIC_AUTH_USER=team
BASIC_AUTH_PASSWORD=
