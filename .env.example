# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# --- Embeddings ---
# "local"  : free, runs on this machine (Chroma's default MiniLM model), no key needed
# "openai" : any OpenAI-compatible endpoint (uses the two OPENAI_* values below)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM / OpenAI-compatible endpoint (used for generation, and for embeddings if provider=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Vector store & chunking (defaults shown) ---
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=60

# --- Semantic search ---
TOP_K=4
# Minimum cosine similarity (0-1) for a chunk to count as relevant. Calibrated for the local model.
MIN_SCORE=0.30

# --- Re-ranking (after the vector search, an LLM judge scores each candidate entry 0-10) ---
RERANKER=llm              # "llm" or "none" (vector order only)
RERANK_MODEL=gpt-4o-mini
CANDIDATES=20             # chunks fetched from Chroma before re-ranking
RERANK_MIN_SCORE=5        # entries scoring below this are dropped (0-10)

# --- Optional groundedness check (an extra model call per answer; rewrites answers with unsupported claims) ---
# Off by default: in our A/B test it did not reduce unsupported claims.
VERIFY_ANSWERS=false

# --- Conversation memory (rewrites follow-up questions like "and for EKS?" using the recent chat) ---
CONDENSE_MODEL=gpt-4o-mini

# --- Protect a public API (set the same value on the website: see docs/deploy.md) ---
# Any long random string, e.g. from:  openssl rand -hex 32
API_SHARED_SECRET=

# --- Deployment with docker compose (see docs/deploy.md) ---
# ":80" = plain HTTP (testing). A domain name (chat.example.com) = automatic HTTPS.
SITE_ADDRESS=:80
# Everyone must log in. Make the hash with:  docker run --rm caddy caddy hash-password
# Keep the single quotes: the hash contains "$" characters that Compose would otherwise expand.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=''
# 127.0.0.1 keeps the site private on the server (use it with a Cloudflare Tunnel); default is public.
#WEB_BIND=127.0.0.1
